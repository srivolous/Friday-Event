# ─── LiveKit (optional, for voice agent) ───
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── LLM Backend ───
# Set GOOGLE_API_KEY to use Gemini (recommended).
# If left blank, falls back to Ollama.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ─── Ollama (fallback) ───
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# ─── Email (optional) ───
GMAIL_USER=
GMAIL_APP_PASSWORD=
