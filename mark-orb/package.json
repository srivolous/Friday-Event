{
  "name": "friday",
  "version": "0.1.0",
  "description": "F.R.I.D.A.Y. — AI Desktop Assistant with holographic orb UI. Supports Gemini (cloud) and Ollama (local) backends.",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "dev": "node fix-electron.js dev",
    "build": "node fix-electron.js build",
    "preview": "node fix-electron.js preview",
    "dist": "node fix-electron.js build && electron-builder",
    "dist:win": "node fix-electron.js build && electron-builder --win",
    "dist:mac": "node fix-electron.js build && electron-builder --mac",
    "dist:linux": "node fix-electron.js build && electron-builder --linux"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@xenova/transformers": "^2.17.2",
    "three": "^0.160.1"
  },
  "optionalDependencies": {
    "loudness": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "~2.2.0",
    "typescript": "^5.4.5",
    "vite": "~5.2.11"
  },
  "build": {
    "appId": "com.local.friday-jarvis",
    "productName": "FRIDAY",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  }
}
